# ==============================================================================
# DET Academy - Production & Development Environment Configuration
# Скопируйте этот файл в .env и укажите актуальные значения для вашего сервера
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend (Next.js)
# ------------------------------------------------------------------------------
# Внутренний порт Next.js внутри контейнера
PORT=3000
# Внешний порт контейнера frontend на сервере (проксируется через nginx на 80/443)
FRONTEND_PORT=13000
NODE_ENV=production

# URL для вызова API бэкенда:
# Для продакшна (через nginx reverse proxy): https://det-academy.ru
# Для локальной разработки: http://localhost:18080
NEXT_PUBLIC_API_URL=https://det-academy.ru
# Arena and advertising are paused for now. Set to true to bring them back.
NEXT_PUBLIC_ARENA_ENABLED=false
NEXT_PUBLIC_ADS_ENABLED=false

# Directus CMS URL
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:18055

# ------------------------------------------------------------------------------
# 2. OAuth Авторизация (Google, VK ID, Яндекс ID)
# ------------------------------------------------------------------------------
# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=761959416802-kci3cchgtt5cncaje9qj9gni6al2euve.apps.googleusercontent.com
GOOGLE_CLIENT_ID=761959416802-kci3cchgtt5cncaje9qj9gni6al2euve.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Apple Sign In (Services ID + Key)
NEXT_PUBLIC_APPLE_CLIENT_ID=com.detacademy.web
APPLE_CLIENT_ID=com.detacademy.web
APPLE_SERVICE_ID=com.detacademy.web
# Apple authorization-code flow (optional, enables code exchange)
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
# PKCS8 PEM; use \n escapes in .env
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Optional overrides for tests/self-hosted JWKS proxy
# APPLE_JWKS_URL=https://appleid.apple.com/auth/keys

# VK ID (Портал разработчиков id.vk.ru -> Настройки приложения)
# ID приложения (числовой идентификатор)
NEXT_PUBLIC_VK_CLIENT_ID=54805089
# Защищённый ключ из раздела «Ключи доступа»
VK_CLIENT_SECRET=your_vk_secure_key_here

# Яндекс ID (oauth.yandex.ru -> Настройки приложения)
# ClientID приложения Яндекс
NEXT_PUBLIC_YANDEX_CLIENT_ID=your_yandex_client_id_here
# Client secret (секретный ключ приложения)
YANDEX_CLIENT_SECRET=your_yandex_client_secret_here

# ------------------------------------------------------------------------------
# 3. Backend API (Go)
# ------------------------------------------------------------------------------
# Внешний порт Go API на хосте (проксируется через nginx: /api/ -> 18080)
BACKEND_PORT=18080

# Строка подключения к PostgreSQL:
# Внутри docker-сети: postgres://postgres:postgres@postgres:5432/det_academy?sslmode=disable
# С хоста напрямую: postgres://postgres:postgres@localhost:15432/det_academy?sslmode=disable
DATABASE_URL=postgres://postgres:CHANGE_ME_DB_PASSWORD@postgres:5432/det_academy?sslmode=disable
ALLOW_MEMORY_STORAGE=false
MEDIA_UPLOAD_DIR=/data/media

# Секретный ключ для подписи JWT токенов авторизации (сгенерируйте случайную строку)
JWT_SECRET=CHANGE_ME_OPENSSL_RAND_HEX_32

# Первый администратор создаётся только при явной настройке.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_12PLUS
# BOOTSTRAP_ADMIN_NAME=Administrator

# Email verification (production: set true)
REQUIRE_EMAIL_VERIFICATION=false
PUBLIC_APP_URL=http://localhost:3000
# ------------------------------------------------------------------------------
# 3.2 External AI (Yandex AI Studio, OpenAI-compatible)
# ------------------------------------------------------------------------------
# The key is server-only: never commit it. Yandex AI Studio uses model URIs of
# the form gpt://<folder_id>/<model>.
# Verified against AI Studio on 2026-10-27:
#   aliceai-llm/latest     -> reliable JSON, ~2 s, used for evaluation
#   yandexgpt-5-lite/latest -> fastest JSON, used for enrichment
# AI_BASE_URL=https://ai.api.cloud.yandex.net/v1
# AI_API_KEY=CHANGE_ME_AI_KEY
# AI_FOLDER_ID=your_yandex_folder_id
# AI_MODEL=gpt://your_yandex_folder_id/aliceai-llm/latest
# AI_MODEL_FAST=gpt://your_yandex_folder_id/yandexgpt-5-lite/latest
# AI_MODEL_EVAL=gpt://your_yandex_folder_id/aliceai-llm/latest
# Speech recognition. Yandex SpeechKit is verified end-to-end; the adapter
# converts WebM/Opus to 16 kHz OggOpus with ffmpeg and splits long answers.
# AI_STT_ENABLED=true
# AI_STT_PROVIDER=yandex_speechkit
# AI_STT_API_KEY=CHANGE_ME_SPEECHKIT_KEY   # falls back to AI_API_KEY
# AI_STT_LANG=en-US
# AI_STT_CHUNK_SECONDS=20
# AI_STT_MODEL=whisper-1                    # OpenAI-compatible provider only
# With server-side STT the browser transcript is not needed:
# ALLOW_CLIENT_TRANSCRIPT=false
# REQUIRE_NEURAL_EVALUATION=true
# Prices per 1M tokens for the admin cost dashboard (0 = show tokens only):
# AI_PRICE_INPUT_PER_1M=0
# AI_PRICE_OUTPUT_PER_1M=0
# AI_PRICE_CURRENCY=RUB

# Neural evaluation for Speaking/Writing (OpenAI-compatible or Ollama).
# Production requires the neural evaluator to be authoritative, not just an enrichment.
# AI_BASE_URL=http://ollama:11434/v1
# AI_API_KEY=...
# AI_MODEL=llama3.1:8b
# AI_STT_ENABLED=true
# REQUIRE_NEURAL_EVALUATION=true
# Free speaking path: the browser recognises speech and sends the transcript,
# so Speaking can be scored without a paid STT provider. The result is marked
# as practice-grade. Set to false to require server-side transcription only.
ALLOW_CLIENT_TRANSCRIPT=true

# RESEND_API_KEY=...
# EMAIL_FROM="DET Academy <noreply@det-academy.ru>"

# ------------------------------------------------------------------------------
# 3.1 Email delivery (SMTP, Beget)
# ------------------------------------------------------------------------------
# The domain mail account on Beget provides an SMTP service. When SMTP_HOST is
# set the backend sends through it, otherwise it falls back to RESEND_API_KEY and
# finally to the log sender.
# SMTP_HOST=smtp.beget.com
# SMTP_PORT=587            # 587 = STARTTLS, 465 = implicit TLS
# SMTP_USERNAME=mailer@det-academy.ru
# SMTP_PASSWORD=CHANGE_ME_MAIL_PASSWORD
# SMTP_FROM="DET Academy <noreply@det-academy.ru>"
# SMTP_IMPLICIT_TLS=false  # true for port 465 (auto-enabled there)

# Backend error tracking. Leave empty to disable Sentry locally.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_RELEASE=det-academy@2026.1

# Protects GET /api/v1/metrics. When set, the endpoint requires
# "Authorization: Bearer <token>" or "?token=<token>".
# METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN

# Разрешенные источники для CORS (через запятую)
ALLOWED_ORIGIN=https://det-academy.ru,http://det-academy.ru,https://www.det-academy.ru,http://localhost:3000,http://localhost:13000

# ------------------------------------------------------------------------------
# 4. База данных (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=det_academy
# Нестандартный порт на хосте (привязан к 127.0.0.1 для безопасности)
POSTGRES_PORT=15432

# ------------------------------------------------------------------------------
# 5. Directus Headless CMS
# ------------------------------------------------------------------------------
# Порт панели управления CMS: http://det-academy.ru:18055 или localhost
DIRECTUS_PORT=18055
DIRECTUS_ADMIN_EMAIL=admin@det-academy.ru
DIRECTUS_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
DIRECTUS_KEY=CHANGE_ME_RANDOM_KEY
DIRECTUS_SECRET=CHANGE_ME_RANDOM_SECRET
