{
  "name": "det-academy",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "test:backend": "cd backend && go test ./...",
    "test:e2e:fullstack": "playwright test -c playwright.fullstack.config.ts",
    "preflight:external": "node --env-file-if-exists=.env scripts/preflight_external.mjs",
    "preflight:directus": "node --env-file-if-exists=.env scripts/directus_preflight.mjs",
    "preflight:edge": "node scripts/edge_preflight.mjs",
    "calibration:test": "python3 scripts/test_calibration.py",
    "calibration:report": "python3 scripts/calibration_report.py",
    "calibration:gate": "python3 scripts/calibration_validate.py",
    "nginx:validate": "bash scripts/validate_nginx_config.sh",
    "test:contracts": "bash scripts/external_contract_test.sh",
    "validate:schema": "bash scripts/validate_schema.sh",
    "check:bundle": "bash scripts/check_bundle.sh"
  },
  "dependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.22",
    "canvas-confetti": "^1.9.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.50.0",
    "next": "16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
